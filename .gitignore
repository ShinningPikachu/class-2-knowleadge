# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and secrets
.venv/
.env
.env.*
!.env.example

# Streamlit local configuration
.streamlit/secrets.toml

# OS and editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
macos/.build/
macos/.swiftpm/
macos/Build/
native_settings.json
*.json.part

# Runtime and local processing data
runs/
jobs/
# The library database and original subject files are shared with the repository.
# Keep transient SQLite journals and generated previews out of Git.
/library/*.sqlite3-shm
/library/*.sqlite3-wal
/library/*.sqlite3-journal
/library/.preview_cache/
/library/subjects/**/derived/
/library/**/*.part
database/*
!database/.gitkeep
models/*
!models/.gitkeep
# audio/, pdf/, and reviewed/ contain user-owned course materials and are shareable.

# 本机 socket 通道（DSH 插件用）
.native_backend.sock
